{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "04-journeys",
  "title": "用户旅程确认检查点",
  "type": "object",
  "required": [
    "checkpoint",
    "context_snapshot",
    "status",
    "user_confirmed",
    "confirmation_message_summary",
    "confirmation_user_message",
    "confirmed_value_sections",
    "alignment_md_sha256",
    "presentation_review",
    "alignment_review",
    "scope",
    "journeys",
    "quality_review"
  ],
  "additionalProperties": false,
  "properties": {
    "checkpoint": {
      "const": "04-journeys"
    },
    "context_snapshot": {
      "type": "object", "required": ["research_question", "decision_use", "research_type", "paradigm"], "additionalProperties": false,
      "properties": {
        "research_question": {"type": "string", "minLength": 8, "maxLength": 500},
        "decision_use": {"type": "string", "minLength": 8, "maxLength": 500},
        "research_type": {"enum": ["toB", "toC", "toD"]},
        "paradigm": {"enum": ["R1", "R2", "R3", "R4", "R5"]}
      }
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "validated", "not_applicable"]
    },
    "user_confirmed": {
      "type": "boolean"
    },
    "confirmation_message_summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "confirmation_user_message": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500
    },
    "confirmed_value_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["scope", "stages", "substages", "lanes", "nodes", "edges", "painpoints_or_gaps", "touchpoints", "emotions", "evidence"]}
    },
    "alignment_md_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "presentation_review": {
      "type": "object",
      "required": [
        "confirmation_kind", "full_content_presented", "journey_ids_presented",
        "journey_count", "stage_count", "content_item_count",
        "evidence_binding_count", "journeys_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "confirmation_kind": {"enum": ["full_journey_content", "no_journey_decision"]},
        "full_content_presented": {"type": "boolean"},
        "journey_ids_presented": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "journey_count": {"type": "integer", "minimum": 0, "maximum": 20},
        "stage_count": {"type": "integer", "minimum": 0, "maximum": 120},
        "content_item_count": {"type": "integer", "minimum": 0, "maximum": 2000},
        "evidence_binding_count": {"type": "integer", "minimum": 0, "maximum": 4000},
        "journeys_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "alignment_review": {
      "type": "object",
      "required": ["mode", "rounds"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["single_pass", "guided_rounds"]},
        "rounds": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "label", "required_phrase", "confirmed", "user_message", "content_sha256"],
            "additionalProperties": false,
            "properties": {
              "id": {"enum": ["global_map", "role_responsibility", "individual_journeys", "branches_evidence"]},
              "label": {"type": "string", "minLength": 2, "maxLength": 30},
              "required_phrase": {"type": "string", "minLength": 4, "maxLength": 30},
              "confirmed": {"type": "boolean"},
              "user_message": {"type": "string", "maxLength": 500},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "not_applicable_reason": {
      "type": "string",
      "maxLength": 300
    },
    "scope": {
      "type": "string",
      "enum": [
        "none",
        "single-persona",
        "per-persona",
        "overall-only",
        "overall-and-per-persona"
      ]
    },
    "journeys": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["persona_id", "component_type", "props", "evidence_bindings"],
        "additionalProperties": false,
        "properties": {
          "persona_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "component_type": {
            "type": "string",
            "enum": ["tob_journey_l1", "tob_journey_l2", "journey_2c"]
          },
          "props": {
            "type": "object"
          },
          "evidence_bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "evidence_type", "source_ids", "quote_or_basis"],
              "additionalProperties": false,
              "properties": {
                "target": {"type": "string", "pattern": "^(stage|node|edge|focus|tool|cell|emotion):.+$"},
                "evidence_type": {"enum": ["primary", "supplemental", "user_context", "synthesis"]},
                "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9A-F]{8}$"}},
                "quote_or_basis": {"type": "string", "minLength": 2, "maxLength": 300}
              },
              "allOf": [{
                "if": {"properties": {"evidence_type": {"enum": ["primary", "supplemental"]}}},
                "then": {"properties": {"source_ids": {"minItems": 1, "maxItems": 1}}},
                "else": {"properties": {"source_ids": {"maxItems": 0}}}
              }]
            }
          }
        }
      }
    },
    "quality_review": {
      "type": "object",
      "required": [
        "stage_names_confirmed",
        "flow_order_confirmed",
        "evidence_gaps",
        "evidence_gaps_acknowledged"
      ],
      "additionalProperties": false,
      "properties": {
        "stage_names_confirmed": {"type": "boolean"},
        "flow_order_confirmed": {"type": "boolean"},
        "evidence_gaps": {
          "type": "array",
          "items": {"type": "string", "minLength": 2, "maxLength": 200}
        },
        "evidence_gaps_acknowledged": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 500}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_applicable"}}},
      "then": {
        "properties": {
          "scope": {"const": "none"},
          "journeys": {"maxItems": 0},
          "not_applicable_reason": {"type": "string", "minLength": 8},
          "user_confirmed": {"const": true},
          "presentation_review": {
            "properties": {
              "confirmation_kind": {"const": "no_journey_decision"},
              "full_content_presented": {"const": false},
              "journey_count": {"const": 0},
              "stage_count": {"const": 0},
              "content_item_count": {"const": 0},
              "evidence_binding_count": {"const": 0}
            }
          }
        },
        "required": ["not_applicable_reason"]
      },
      "else": {
        "properties": {
          "scope": {"not": {"const": "none"}},
          "journeys": {"minItems": 1},
          "user_confirmed": {"const": true},
          "presentation_review": {
            "properties": {
              "confirmation_kind": {"const": "full_journey_content"},
              "full_content_presented": {"const": true},
              "journey_count": {"minimum": 1},
              "stage_count": {"minimum": 1},
              "content_item_count": {"minimum": 1}
            }
          },
          "quality_review": {
            "properties": {
              "stage_names_confirmed": {"const": true},
              "flow_order_confirmed": {"const": true},
              "evidence_gaps_acknowledged": {"const": true}
            }
          }
        }
      }
    }
  ]
}
