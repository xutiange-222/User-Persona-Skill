{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "02-classification",
  "type": "object",
  "required": ["checkpoint", "status", "context_snapshot", "classification_basis", "boundary_rules", "evidence_summary", "uncertainties", "user_confirmed", "confirmation_message_summary", "groups", "respondent_mapping", "value_variables", "confirmed_value_sections"],
  "additionalProperties": false,
  "properties": {
    "checkpoint": {"const": "02-classification"},
    "context_snapshot": {"type": "object", "required": ["research_question", "decision_use", "research_type", "paradigm"], "additionalProperties": false, "properties": {
      "research_question": {"type": "string", "minLength": 8, "maxLength": 500},
      "decision_use": {"type": "string", "minLength": 8, "maxLength": 500},
      "research_type": {"enum": ["toB", "toC", "toD"]},
      "paradigm": {"enum": ["R1", "R2", "R3", "R4", "R5"]}
    }},
    "status": {"enum": ["confirmed", "validated", "not_applicable"]},
    "not_applicable_reason": {"type": "string", "maxLength": 500},
    "classification_basis": {"type": "string", "maxLength": 500},
    "boundary_rules": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 500}},
    "evidence_summary": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 500}},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 500}},
    "groups": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "name", "definition", "members", "evidence_source_ids", "sample_risk"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^persona-[0-9]+$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 40},
          "definition": {"type": "string", "minLength": 4, "maxLength": 500},
          "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9A-F]{8}$"}},
          "evidence_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P[0-9A-F]{8}$"}},
          "sample_risk": {"type": "string", "minLength": 2, "maxLength": 300}
        }
      }
    },
    "respondent_mapping": {
      "type": "object",
      "propertyNames": {"pattern": "^P[0-9A-F]{8}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["source_id", "group_id", "variable_levels", "evidence_quotes", "uncertainty"],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "pattern": "^P[0-9A-F]{8}$"},
          "group_id": {"type": ["string", "null"], "pattern": "^persona-[0-9]+$"},
          "variable_levels": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 60}},
          "evidence_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8, "maxLength": 500}},
          "uncertainty": {"type": "string", "maxLength": 300}
        }
      }
    },
    "value_variables": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "definition", "levels"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,30}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 30},
          "definition": {"type": "string", "minLength": 8, "maxLength": 500},
          "levels": {"type": "array", "minItems": 2, "maxItems": 3, "items": {
            "type": "object", "required": ["id", "name", "behavior_definition"], "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,30}$"},
              "name": {"type": "string", "minLength": 2, "maxLength": 20},
              "behavior_definition": {"type": "string", "minLength": 8, "maxLength": 300}
            }
          }}
        }
      }
    },
    "axes": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {"x": {"type": "string"}, "y": {"type": "string"}}
    },
    "empty_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 80}},
    "user_confirmed": {"const": true},
    "label_confirmed": {"type": "boolean"},
    "confirmed_value_sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["applicability", "basis", "boundaries", "labels", "respondent_mapping", "groups", "uncertainties"]}},
    "confirmation_user_message": {"type": "string", "minLength": 2, "maxLength": 500},
    "alignment_md_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confirmation_message_summary": {"type": "string", "minLength": 10, "maxLength": 500}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "not_applicable"}}},
    "then": {
      "required": ["not_applicable_reason", "confirmation_user_message", "alignment_md_sha256"],
      "properties": {
        "not_applicable_reason": {"minLength": 8}, "groups": {"maxItems": 0},
        "respondent_mapping": {"maxProperties": 0}, "value_variables": {"maxItems": 0},
        "confirmed_value_sections": {"contains": {"const": "applicability"}}
      }
    },
    "else": {
      "required": ["label_confirmed", "confirmation_user_message", "alignment_md_sha256"],
      "properties": {
        "classification_basis": {"minLength": 4}, "groups": {"minItems": 1},
        "respondent_mapping": {"minProperties": 1}, "boundary_rules": {"minItems": 1},
        "label_confirmed": {"const": true}
      }
    }
  }]
}
