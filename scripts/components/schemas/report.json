{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report",
  "title": "用户画像报告(顶层 components JSON)",
  "description": "LLM 在阶段最后产出的 05-report.json 必须符合这个 schema。Python render_report.py 读它,按 layouts 拼出最终 report.html。组件化 P8 架构。",
  "type": "object",
  "required": ["metadata", "personas"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "description": "报告级元信息,填顶部 meta-bar 和 _base.html 的 slot",
      "required": [
        "report_title",
        "context_snapshot",
        "theme",
        "density",
        "source_count",
        "source_summary",
        "persona_count",
        "page_count",
        "field_coverage",
        "user_confirmed",
        "confirmation_user_message",
        "confirmed_value_sections",
        "alignment_md_sha256",
        "generated_at",
        "visual_spec"
      ],
      "additionalProperties": false,
      "properties": {
        "report_title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "description": "顶部主标题,例:电力调度员用户画像 — AI 辅助决策需求研究"
        },
        "page_title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60,
          "description": "可选;浏览器 <title> 标签内容,缺省则用 report_title"
        },
        "theme": {
          "type": "string",
          "enum": ["2b", "2c", "2d"],
          "description": "主题色板。toB=2b(深蓝高密度),toC=2c(暖米黄低密度),toD=2d(开发者)"
        },
        "density": {
          "type": "string",
          "enum": ["high", "mid", "low"],
          "description": "信息密度。toB 默认 high,toC 默认 low。双页兜底场景自动切 mid"
        },
        "source_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "去重后的独立主访谈数；不得包含补充材料或重复分配"
        },
        "context_snapshot": {
          "type": "object",
          "required": ["research_question", "decision_use", "research_type", "paradigm"],
          "additionalProperties": false,
          "properties": {
            "research_question": {"type": "string", "minLength": 8, "maxLength": 500},
            "decision_use": {"type": "string", "minLength": 8, "maxLength": 500},
            "research_type": {"enum": ["toB", "toC", "toD"]},
            "paradigm": {"enum": ["R1", "R2", "R3", "R4", "R5"]}
          }
        },
        "source_summary": {
          "type": "object",
          "required": ["unique_primary_interviews", "unique_supplemental_sources", "analysis_assignment_count"],
          "additionalProperties": false,
          "properties": {
            "unique_primary_interviews": {"type": "integer", "minimum": 1},
            "unique_supplemental_sources": {"type": "integer", "minimum": 0},
            "analysis_assignment_count": {"type": "integer", "minimum": 1}
          }
        },
        "persona_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "画像数量。tab 数量上限 12(visual-system.md §3.2)"
        },
        "field_coverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "逐画像记录 03 已确认字段如何进入 05。未进入报告的字段必须逐项说明原因，禁止静默丢失。",
          "items": {
            "type": "object",
            "required": ["persona_id", "included_fields", "omitted_fields"],
            "additionalProperties": false,
            "properties": {
              "persona_id": {"type": "string", "pattern": "^persona-[0-9]+$"},
              "included_fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 80}
              },
              "omitted_fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field", "reason"],
                  "additionalProperties": false,
                  "properties": {
                    "field": {"type": "string", "minLength": 1, "maxLength": 80},
                    "reason": {"type": "string", "minLength": 4, "maxLength": 200}
                  }
                }
              }
            }
          }
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "description": "用户确认后的最终 HTML 页数。工作流渲染时必须与 assembler 实际输出一致"
        },
        "user_confirmed": {"type": "boolean"},
        "confirmation_message_summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "confirmation_user_message": {"type": "string", "minLength": 2, "maxLength": 500},
        "confirmed_value_sections": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {"enum": ["page_plan", "modules", "visual_spec", "information_loss"]}
        },
        "alignment_md_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2})?$",
          "description": "生成时间。格式 YYYY-MM-DD 或 YYYY-MM-DD HH:MM"
        },
        "visual_spec": {
          "type": "object",
          "description": "从 03-field-alignment.json 继承的视觉模板和色板选择",
          "required": ["template_id", "palette_id", "palette_reason"],
          "additionalProperties": false,
          "properties": {
            "template_id": {
              "type": "string",
              "enum": [
                "2b-overall-journey",
                "2c-persona",
                "2c-journey",
                "2c-complex-distribution-report"
              ]
            },
            "palette_id": {
              "type": "string",
              "enum": [
                "2b-process-blue",
                "2c-purple-default",
                "2c-red-orange",
                "2c-green-gray",
                "2c-yellow-orange",
                "2c-blue-yellow",
                "2c-cyan-gold"
              ]
            },
            "palette_reason": {
              "type": "string",
              "minLength": 12,
              "maxLength": 120
            },
            "persona_palette_map": {
              "type": "object",
              "description": "2C 多画像中 persona 基础 id 到色板 ID 的固定映射。画像页、详情页、旅程页共用。",
              "propertyNames": {"pattern": "^persona-[0-9]+$"},
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "2c-purple-default",
                  "2c-red-orange",
                  "2c-green-gray",
                  "2c-yellow-orange",
                  "2c-blue-yellow",
                  "2c-cyan-gold"
                ]
              }
            }
          }
        }
      }
    },

    "personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "画像列表。每个画像对应一个 .persona-slide section。多画像 + 旅程页 + detail 页 + L1 全景等都拍平到这个数组,Python 按 id 命名自动配 nav-pair",
      "items": {
        "type": "object",
        "required": ["id", "name", "layout", "components"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^(persona-(\\d+(-(journey|core|detail|detail-\\d+))?|q[1-4])|journey-l1|matrix|distribution)$",
            "description": "画像 section 的 id。命名约定见 visual-system.md §3.2:persona-N / persona-N-journey / persona-N-core / persona-N-detail / persona-N-detail-K / persona-qN(R4 象限) / journey-l1(L1 全景) / matrix(矩阵首页) / distribution(分布首页)"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20,
            "description": "画像名以语义完整和可区分为先，同时尽量一行呈现；允许英文头衔拼接如'交付型 Scrum Master'。R4 象限名遵循范式确认结果。"
          },
          "layout": {
            "type": "string",
            "enum": [
              "layout-2b-grid",
              "layout-2b-grid-detail",
              "layout-2b-journey",
              "layout-2c-portrait",
              "layout-2c-detail",
              "layout-2c-journey",
              "layout-matrix-2d",
              "layout-distribution-multi"
            ],
            "description": "8 个 layout 选 1。LLM 不主动选 layout-2b-grid-detail(由 Python solver 拆双页时自动设)"
          },
          "accent": {
            "type": "string",
            "enum": [
              "purple",
              "mist-blue",
              "moss-green",
              "warm-orange",
              "mustard",
              "cyan-gold"
            ],
            "description": "2C 主题强调色 6 选 1。2B/2D 主题忽略本字段(可不填)。AI 类画像强制 purple;否则按 visual-system.md §4 哈希算法选"
          },
          "subtitle_for_nav": {
            "type": "string",
            "maxLength": 8,
            "description": "可选;给 nav-pair 右半按钮的文字前缀,默认按 id 后缀自动推:-journey→旅程,-detail→细节,-core→核心,-detail-K→专题"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "description": "本画像里要渲染的组件序列。LLM 不写 grid 坐标,只按重要性排序;Python solver 自动布局。注意:容器型 layout(matrix_2d / distribution_multi / journey_2c / tob_journey_l1/l2)整个 layout 通常只放 1 个容器组件,可选附 matrix_guidance_strip 等独立组件",
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "oneOf": [
                {"required": ["props"], "not": {"required": ["content_ref"]}},
                {"required": ["content_ref"], "not": {"required": ["props"]}}
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "identity_panel",
                    "resp_rings",
                    "collab_flow",
                    "scenario_grid",
                    "ai_scenario_grid",
                    "painpoint_list",
                    "titled_list",
                    "generic_text",
                    "generic_bullet",
                    "generic_kv",
                    "tob_journey_l1",
                    "tob_journey_l2",
                    "identity_card",
                    "persona_quote_pull",
                    "section_blocks_grid",
                    "detail_headline",
                    "mockup_list",
                    "detail_analysis",
                    "detail_illust_corner",
                    "journey_2c",
                    "matrix_guidance_strip",
                    "matrix_2d",
                    "distribution_multi"
                  ],
                  "description": "24 个允许的顶层组件 type。section_block 只能作为 section_blocks_grid.blocks 的子项出现。props 字段由对应 schemas/<type>.json 单独严格校验"
                },
                "props": {
                  "type": "object",
                  "description": "组件的属性。具体字段约束在 schemas/<type>.json,由 validate_components_json.py 二次校验"
                },
                "content_ref": {
                  "type": "string",
                  "pattern": "^/personas/[0-9]+/display_components/[0-9]+$",
                  "description": "画像页和细节页引用 04-personas.json 已确认的组件真值"
                }
              }
            }
          }
        }
      }
    }
  }
}
